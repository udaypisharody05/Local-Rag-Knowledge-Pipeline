APP_NAME=Local RAG Knowledge Pipeline
APP_ENV=development
API_KEY=change-me-before-running
POSTGRES_PASSWORD=change-me-before-running-too
DATABASE_URL=postgresql+psycopg://rag:change-me-before-running-too@postgres:5432/rag_db
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
STORAGE_ROOT=storage/documents
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=32
OLLAMA_TIMEOUT_SECONDS=60
DENSE_TOP_K=5
DENSE_MAX_K=20
INDEX_STORAGE_ROOT=storage/indexes/versions
